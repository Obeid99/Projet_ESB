GROQ_API_KEY=your_groq_api_key_here
# OpenAI API Configuration (fallback)
OPENAI_API_KEY=your_openai_api_key_here

# Database Configuration
MONGO_URI=mongodb://your_mongo_host:27017
MONGO_DB_NAME=your_db_name
MONGO_COLLECTION_AUTH_STUD=student_auth
MONGO_COLLECTION_AUTH_ADMIN=admin_auth
MONGO_COLLECTION_CHAT_ADMIN=history_admin
MONGO_COLLECTION_CHAT_STUD=history_student
# Sentiment Analysis Configuration
SENTIMENT_MODEL=hybrid  # Options: textblob, vader, ollama, hybrid
SENTIMENT_THRESHOLD_POSITIVE=0.1
SENTIMENT_THRESHOLD_NEGATIVE=-0.1

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/chatbot.log

# ESB Specific Configuration
ESB_WEBSITE_URL=https://esprit.tn
ESB_FACEBOOK_URL=https://facebook.com/esprit.tn
