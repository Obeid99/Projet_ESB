# LLM Provider Configuration
LLM_PROVIDER=ollama  # Options: ollama, openai

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b   # Options: llama3.1, llama3, mistral, codellama, etc.
OLLAMA_TIMEOUT=60

# OpenAI API Configuration (fallback)
OPENAI_API_KEY=your_openai_api_key_here

# Database Configuration
DATABASE_URL=postgresql://esbuser:esbpass@db:5432/esbchatbot

# Sentiment Analysis Configuration
SENTIMENT_MODEL=hybrid  # Options: textblob, vader, ollama, hybrid
SENTIMENT_THRESHOLD_POSITIVE=0.1
SENTIMENT_THRESHOLD_NEGATIVE=-0.1

# Logging
LOG_LEVEL=INFO
LOG_FILE=logs/chatbot.log

# ESB Specific Configuration
ESB_WEBSITE_URL=https://esprit.tn
ESB_FACEBOOK_URL=https://facebook.com/esprit.tn
